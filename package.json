{
  "name": "helium-discord-bot",
  "version": "4.0.0",
  "description": "Helium Discord bot backend (default bot display name: Lumin)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc index.js",
    "dev": "node --max-old-space-size=512 --expose-gc --watch index.js",
    "check": "node scripts/check-imports.js && node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "discord",
    "bot",
    "google-genai",
    "gemini",
    "helium",
    "api-first",
    "security"
  ],
  "author": "Helium contributors",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "axios": "^1.16.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "lru-cache": "^11.1.0",
    "mongodb": "^6.16.0",
    "node-cron": "^4.2.1",
    "node-os-utils": "^1.3.7",
    "office-text-extractor": "^4.0.0",
    "redis": "^4.7.1",
    "sharp": "^0.34.2",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
