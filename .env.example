# ==============================================================================
# PROJECT HELIUM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with production credentials.
# Never commit actual secret keys or tokens into version control.
# ==============================================================================

# Discord Gateway Credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Persistence (MongoDB Connection String)
MONGODB_URI=mongodb://localhost:27017/helium

# Google Gemini API Key Pool (Comma-separated for round-robin rotation)
GEMINI_API_KEYS=AIzaSyD_ExampleKey1,AIzaSyD_ExampleKey2

# White-Label Agent Persona Call-Sign (Default: Lumin)
SYSTEM_AGENT_CALLSIGN=Lumin

# Master Personalization Engine (true = full unified memory; false = tabula rasa)
DEFAULT_PERSONALIZATION_ENABLED=true

# Cache Subsystem (false = native FastMemoryCache on 25MB heap; true = external Redis)
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379

# Render Free Tier HTTP Liveness Server & Dashboard
PORT=3000
SESSION_SECRET=minimum_32_character_cryptographically_secure_secret_entropy_token

# Execution Dynamics (async = single-thread event loop for 0.1 vCPU; parallel = worker threads)
EXECUTION_MODE=async

# Node Environment & Telemetry
NODE_ENV=production
LOG_LEVEL=info
