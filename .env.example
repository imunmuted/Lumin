# Helium backend environment — replace every placeholder before deployment.
NODE_ENV=production
PORT=3000
BOT_NAME=Lumin
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
MONGODB_URI=mongodb+srv://replace-me
GOOGLE_API_KEY=replace-with-google-genai-api-key
# Optional comma-separated API keys for key rotation.
GOOGLE_API_KEYS=

# Owner identity is environment-only; do not assign owner through the console.
HELIUM_OWNER_EMAIL=
HELIUM_OWNER_DISCORD_ID=
# Optional staff role grants (JSON array). Guild roles must list explicit guild snowflake IDs.
HELIUM_STAFF_ROLES_JSON=[]

# Google OAuth (register callback exactly as deployed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://YOUR-API-HOST/dashboard/auth/google/callback
# Discord OAuth (register callback exactly as deployed).
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CALLBACK_URL=https://YOUR-API-HOST/dashboard/auth/discord/callback
# External frontend URL and exact allowed browser origins (comma-separated).
HELIUM_CONSOLE_URL=https://YOUR-CONSOLE-HOST/
HELIUM_CONSOLE_ORIGINS=https://YOUR-CONSOLE-HOST
HELIUM_API_PUBLIC_ORIGIN=
HELIUM_COOKIE_SECURE=true
# Set None for a truly cross-site frontend/backend deployment; requires Secure=true.
HELIUM_COOKIE_SAME_SITE=None

# CAPTCHA is fail-closed in production when required.
HELIUM_RECAPTCHA_REQUIRED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Required when CAPTCHA is enabled: exact hostnames returned by reCAPTCHA (comma-separated, no scheme).
HELIUM_CONSOLE_HOSTNAMES=YOUR-CONSOLE-HOST
HELIUM_RECAPTCHA_MIN_SCORE=0.5

# High-risk admin features are deliberately off by default.
HELIUM_ENABLE_ADMIN_TERMINALS=false
HELIUM_ENABLE_FILE_EDITOR=false
# Comma-separated Discord user IDs explicitly granted attachment analysis. Default deny.
HELIUM_ATTACHMENT_ALLOWLIST=

# Optional Redis ONLY for distributed security rate limits; never used for memory.
HELIUM_REDIS_ENABLED=false
REDIS_URL=
